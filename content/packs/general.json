  "description_ar": "الأساس: التحيات، التعارف، الأرقام والعمر. يضم الدروس الثلاثة الأولى في التطبيق.",
  "vocabulary": [
    { "id": "gen.v.hello", "term": "Hello", "ar": "مرحباً", "say_ar": "هَلُو", "pos": "interjection", "level": "A1", "example_en": "Hello, Sara!", "example_ar": "مرحباً يا سارة!", "lesson": "gen.l1" },
    { "id": "gen.v.good-morning", "term": "Good morning", "ar": "صباح الخير", "say_ar": "جُود مورنِنج", "pos": "phrase", "level": "A1", "example_en": "Good morning, teacher.", "example_ar": "صباح الخير يا معلم.", "lesson": "gen.l1" },
    { "id": "gen.v.thank-you", "term": "Thank you", "ar": "شكراً", "say_ar": "ثانك يو", "pos": "phrase", "level": "A1", "example_en": "Thank you for your help.", "example_ar": "شكراً على مساعدتك.", "lesson": "gen.l1" },
    { "id": "gen.v.goodbye", "term": "Goodbye", "ar": "إلى اللقاء", "say_ar": "جُود باي", "pos": "interjection", "level": "A1", "example_en": "Goodbye, see you tomorrow.", "example_ar": "إلى اللقاء، أراك غداً.", "lesson": "gen.l1" },
    { "id": "gen.v.whats-your-name", "term": "What is your name?", "ar": "ما اسمك؟", "say_ar": "وُت إز يور نيم؟", "pos": "phrase", "level": "A1", "example_en": "Hi! What is your name?", "example_ar": "أهلاً! ما اسمك؟", "lesson": "gen.l2" },
    { "id": "gen.v.my-name-is", "term": "My name is ...", "ar": "اسمي ...", "say_ar": "ماي نيم إز", "pos": "phrase", "level": "A1", "example_en": "My name is Ahmed.", "example_ar": "اسمي أحمد.", "lesson": "gen.l2" },
    { "id": "gen.v.how-are-you", "term": "How are you?", "ar": "كيف حالك؟", "say_ar": "هاو آر يو؟", "pos": "phrase", "level": "A1", "example_en": "Hello Ali, how are you?", "example_ar": "مرحباً يا علي، كيف حالك؟", "lesson": "gen.l2" },
    { "id": "gen.v.i-am-fine", "term": "I am fine", "ar": "أنا بخير", "say_ar": "آي آم فاين", "pos": "phrase", "level": "A1", "example_en": "I am fine, thank you.", "example_ar": "أنا بخير، شكراً.", "lesson": "gen.l2" },
