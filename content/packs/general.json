  "questions": [
    { "id": "gen.q.01", "type": "mcq", "skill": "comprehension", "difficulty": 1, "lesson": "gen.l1", "refs": ["gen.v.goodbye"],
      "prompt_ar": "صديقك يغادر في نهاية اليوم. ماذا تقول له؟",
      "options": ["Goodbye", "Good morning", "Hello", "Thank you"], "answer": 0,
      "explanation_ar": "Goodbye للوداع، أما Good morning فهي تحية عند اللقاء صباحاً." },
    { "id": "gen.q.02", "type": "mcq", "skill": "application", "difficulty": 2, "lesson": "gen.l1", "refs": ["gen.v.good-morning", "gen.v.goodbye"],
      "prompt_ar": "الساعة 8 صباحاً وقد وصلت للتو إلى المدرسة. أي عبارة هي الأنسب لتحية المعلم؟",
      "options": ["Goodbye, teacher.", "Good morning, teacher.", "Thank you, teacher.", "Nice to meet you, goodbye."], "answer": 1,
      "explanation_ar": "عند الوصول صباحاً نقول Good morning؛ Goodbye تُقال عند المغادرة." },
    { "id": "gen.q.03", "type": "match", "skill": "comprehension", "difficulty": 2, "lesson": "gen.l2",
      "refs": ["gen.v.how-are-you", "gen.v.whats-your-name", "gen.v.nice-to-meet-you", "gen.v.i-am-fine"],
      "prompt_ar": "صِل كل عبارة بمعناها:",
      "pairs": [["How are you?", "كيف حالك؟"], ["What is your name?", "ما اسمك؟"], ["Nice to meet you", "سعيد بلقائك"], ["I am fine", "أنا بخير"]],
      "explanation_ar": "انتبه للكلمة الأولى: How = كيف، What = ما." },
    { "id": "gen.q.04", "type": "order", "skill": "application", "difficulty": 2, "lesson": "gen.l2", "refs": ["gen.g.wh-questions", "gen.v.whats-your-name"],
      "prompt_ar": "رتّب الكلمات لتكوّن سؤالاً صحيحاً عن الاسم:",
      "tokens": ["What", "is", "your", "name", "?"],
      "explanation_ar": "في السؤال يأتي is قبل الفاعل: What is your name?" },
    { "id": "gen.q.05", "type": "mcq", "skill": "analysis", "difficulty": 3, "lesson": "gen.l2", "refs": ["gen.g.verb-to-be"],
      "prompt_ar": "أيّ جملة تحتوي على خطأ نحوي؟",
      "options": ["I am fine.", "You are my friend.", "I fine, thank you.", "She is a teacher."], "answer": 2,
      "explanation_ar": "في الإنجليزية لا بد من فعل الكينونة: I am fine." },
    { "id": "gen.q.06", "type": "fill", "skill": "application", "difficulty": 3, "lesson": "gen.l2", "refs": ["gen.g.verb-to-be"],
      "prompt_ar": "أكمل بالكلمة المناسبة: You ___ my best friend.",
      "accept": ["are"], "hint_ar": "you تأخذ دائماً الصيغة نفسها حتى للمفرد.",
      "explanation_ar": "you + are." },
    { "id": "gen.q.07", "type": "mcq", "skill": "comprehension", "difficulty": 1, "lesson": "gen.l3", "refs": ["gen.v.six"],
      "prompt_ar": "ما الرقم الذي يُكتب Six؟",
      "options": ["7", "6", "9", "3"], "answer": 1,
      "explanation_ar": "Six = 6، و Seven = 7." },
    { "id": "gen.q.08", "type": "mcq", "skill": "application", "difficulty": 3, "lesson": "gen.l3", "refs": ["gen.v.three", "gen.v.four", "gen.v.seven"],
      "prompt_ar": "Three + Four = ?",
      "options": ["Eight", "Six", "Seven", "Nine"], "answer": 2,
      "explanation_ar": "3 + 4 = 7 أي Seven." },
    { "id": "gen.q.09", "type": "mcq", "skill": "analysis", "difficulty": 4, "lesson": "gen.l3", "refs": ["gen.g.age"],
      "prompt_ar": "قال أحد المتعلمين: I have nine years. ما التصحيح الأدق؟",
      "options": ["I have nine year.", "I am nine years old.", "I am nine year old.", "My age have nine years."], "answer": 1,
      "explanation_ar": "العمر يُعبَّر عنه بـ am وليس have، و years بالجمع: I am nine years old." },
    { "id": "gen.q.10", "type": "multi", "skill": "analysis", "difficulty": 4, "lesson": "gen.l3", "refs": ["gen.g.age"],
      "prompt_ar": "اختر كل الإجابات الصحيحة عن السؤال How old are you? (قد تكون أكثر من إجابة)",
      "options": ["I am eight.", "I am eight years old.", "I have eight years.", "I am fine."], "answer": [0, 1],
      "explanation_ar": "يمكن قول I am eight أو I am eight years old. أما I am fine فهي جواب How are you." },
    { "id": "gen.q.11", "type": "fill", "skill": "application", "difficulty": 4, "lesson": "gen.l3", "refs": ["gen.v.ten", "gen.v.five", "gen.v.two"],
      "prompt_ar": "اكتب الناتج بالإنجليزية (بالحروف): Ten ÷ Two = ___",
      "accept": ["five"], "explanation_ar": "10 ÷ 2 = 5 أي Five." },
    { "id": "gen.q.12", "type": "mcq", "skill": "analysis", "difficulty": 5, "lesson": "gen.l3", "refs": ["gen.g.wh-questions", "gen.v.how-old", "gen.v.how-are-you"],
      "prompt_ar": "سمعت الجواب: \"He is nine.\" ما السؤال الذي طُرح على الأرجح؟",
      "options": ["How is he?", "How old is he?", "What is his name?", "How old are you?"], "answer": 1,
      "explanation_ar": "الجواب عن عمر شخص غائب (he)، فالسؤال How old is he؟ أما How old are you فيخاطب الشخص نفسه." }
  ],
