    { "id": "gen.v.six", "term": "Six", "ar": "ستة", "say_ar": "سِكْس", "pos": "number", "level": "A1", "lesson": "gen.l3" },
    { "id": "gen.v.seven", "term": "Seven", "ar": "سبعة", "say_ar": "سِفِن", "pos": "number", "level": "A1", "lesson": "gen.l3" },
