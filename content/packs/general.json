    { "id": "gen.v.years-old", "term": "I am ten years old", "ar": "عمري عشر سنوات", "say_ar": "آي آم تِن ييرز أولد", "pos": "phrase", "level": "A1", "lesson": "gen.l3" }
  ],
  "grammar": [
    {
      "id": "gen.g.verb-to-be",
      "title_ar": "فعل الكينونة: am / is / are",
      "level": "A1",
      "rule_ar": "في الإنجليزية لا تُبنى الجملة الاسمية دون فعل. نستخدم am مع I، و is مع he/she/it والمفرد، و are مع you/we/they والجمع.",
      "pattern": "Subject + am/is/are + ...",
      "examples": [
        { "en": "I am fine.", "ar": "أنا بخير." },
        { "en": "She is a teacher.", "ar": "هي معلمة." },
        { "en": "They are students.", "ar": "هم طلاب." }
      ],
      "common_mistakes": [
        { "wrong": "I fine.", "right": "I am fine.", "note_ar": "لا تحذف am كما نفعل في العربية." },
        { "wrong": "You is my friend.", "right": "You are my friend.", "note_ar": "you تأخذ are دائماً حتى للمفرد." }
      ]
    },
    {
      "id": "gen.g.age",
      "title_ar": "التعبير عن العمر",
      "level": "A1",
      "rule_ar": "نعبّر عن العمر بفعل الكينونة وليس بفعل have: I am + الرقم + years old. ويمكن الاكتفاء بالرقم: I am ten.",
      "pattern": "Subject + am/is/are + number + years old",
      "examples": [
        { "en": "I am ten years old.", "ar": "عمري عشر سنوات." },
        { "en": "He is nine.", "ar": "عمره تسع سنوات." }
      ],
      "common_mistakes": [
        { "wrong": "I have ten years.", "right": "I am ten years old.", "note_ar": "ترجمة حرفية من العربية/الفرنسية؛ الصحيح استخدام am." },
        { "wrong": "I am ten year old.", "right": "I am ten years old.", "note_ar": "years بالجمع بعد الأرقام الأكبر من واحد." }
      ]
    },
    {
      "id": "gen.g.wh-questions",
      "title_ar": "أسئلة What و How",
      "level": "A1",
      "rule_ar": "What تسأل عن الشيء (ما/ماذا)، و How تسأل عن الحال أو الطريقة (كيف)، و How old تسأل عن العمر. يأتي فعل الكينونة قبل الفاعل في السؤال.",
      "pattern": "Wh-word + am/is/are + subject ?",
      "examples": [
        { "en": "What is your name?", "ar": "ما اسمك؟" },
        { "en": "How are you?", "ar": "كيف حالك؟" },
        { "en": "How old is your brother?", "ar": "كم عمر أخيك؟" }
      ],
      "common_mistakes": [
        { "wrong": "What your name is?", "right": "What is your name?", "note_ar": "الفعل is يسبق الفاعل في السؤال." }
      ]
    }
  ],
